{
  "name": "canvas-live-for-chatgpt",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Read-only Canvas LMS live context bridge for ChatGPT via a Chrome extension.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
