    "test:browser": "node scripts/browser-smoke.mjs && node scripts/composer-smoke.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "linkedom": "0.18.13",
    "pdfjs-dist": "6.3.289",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6"
  }
}
